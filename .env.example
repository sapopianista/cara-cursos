# Copie para .env para ligar o frontend ao backend Java (pasta backend/).

# URL base da API REST. Em dev, "/api" usa o proxy do Vite (vite.config.js).
VITE_API_URL=/api

# "true" usa os dados simulados de src/services/mock. "false" chama a API real
# (exceto os módulos listados em MODULOS_SO_NO_MOCK, em src/services/api.js).
VITE_USAR_MOCK=true

# Tempo máximo (ms) de uma requisição antes de abortar.
VITE_API_TIMEOUT=15000
